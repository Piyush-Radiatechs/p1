# Local SQLite (created automatically). For Streamlit Cloud, use a free
# Neon Postgres URL: https://console.neon.tech — copy the connection string.
# Example: postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=sqlite:///./data/app.db
